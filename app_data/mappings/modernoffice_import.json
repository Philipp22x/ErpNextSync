	{
		"idx": 4,
		"type": "Quotation",
		"doc_type": "Quotation",
		"table_name": "Beleg",
		"primary_key": "rowid__",
		"order_by": "Jahr",
		"timestamp_column_name": "Modifiziert_Datum",
		"timestamp_column_type": "datetime",
		"query_filter": "Kennung = 'A' AND Jahr = 2026 AND [Bezug/Kennz.] LIKE '%FEST%'",
		"query_join": null,
		"mapping": [
			{
				"doctype": "Quotation",
				"reqd": 1,
				"doctype_flags": [
                    {
                        "name_set": 1
                    }
                ],
				"fields": [
					{
						"fieldname": "name",
						"sl_column": "CAST([Jahr] AS VARCHAR(4)) + '-' + RIGHT('00000' + CAST([Nummer] AS VARCHAR(5)), 5) AS BelegNaming",
						"alt_key": "BelegNaming",
						"reqd": 1
					},
					{
						"fieldname": "quotation_to",
						"default": "Customer"
					},
					{
						"fieldname": "party_name",
						"sl_column": "Adressnummer",
						"force_str_type": 1,
						"reqd": 1
					},
					{
						"fieldname": "transaction_date",
						"sl_column": "Belegdatum",
						"reqd": 1
					},
					{
						"fieldname": "currency",
						"sl_column": "Waehrung"
					},
					{
						"fieldname": "order_type",
						"default": "Sales"
					},
					{
						"fieldname": "company",
						"default": "Ackerl Handels GmbH"
					},
					{
						"fieldname": "selling_price_list",
						"default": "Standard Selling"
					},
					{
						"fieldname": "price_list_currency",
						"default": "EUR"
					},
					{
						"fieldname": "custom_footer_text",
						"sl_column": "Fusstext"
					},
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Umwandlungsnummer"
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "CASE WHEN [Umwandlung Kennung] = 'B' THEN CAST([Umwandlung Nummer] AS VARCHAR(50)) ELSE 'Nein' END AS Umwandlungsnummer",
								"alt_key": "Umwandlungsnummer",
								"reqd": 1
                            }
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Auftragsnummer"
                            },
                            {
								"table_fieldname": "info",
								"sl_column": "CASE WHEN [Umwandlung Kennung] = 'B' THEN CAST([Jahr] AS VARCHAR(4)) + '-' + RIGHT('00000' + CAST([Umwandlung Nummer] AS VARCHAR(5)), 5) ELSE 'Nein' END AS Auftragsnummer",
								"alt_key": "Auftragsnummer",
								"reqd": 1
							}
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Belegnummer"
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "Nummer",
								"reqd": 1
                            }
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Bezug/Kennz."
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "Bezug/Kennz.",
                                "reqd": 1
                            }
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Vertreter"
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "VertreterKurz",
                                "reqd": 1
                            }
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Liefertermin KW/W"
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "CAST(SUBSTRING([Bezug/Kennz.], CHARINDEX('FEST', [Bezug/Kennz.]) + 5, CHARINDEX('/', [Bezug/Kennz.], CHARINDEX('FEST', [Bezug/Kennz.])) - CHARINDEX('FEST', [Bezug/Kennz.]) - 5) AS INT) AS LieferKW",
								"alt_key": "LieferKW",
                                "reqd": 1
                            }
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Liefertermin KW/J"
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "2000 + CAST(SUBSTRING([Bezug/Kennz.], CHARINDEX('/', [Bezug/Kennz.], CHARINDEX('FEST', [Bezug/Kennz.])) + 1, 2) AS INT) AS LieferJahr",
								"alt_key": "LieferJahr",
                                "reqd": 1
                            }
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Status"
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "Status",
                                "reqd": 1
                            }
                        ]
                    },
					{
                        "fieldname": "custom_information_table",
                        "table_fields": [
                            {
                                "table_fieldname": "type",
                                "default": "WINFO: Bestellnummer Kunde"
                            },
                            {
                                "table_fieldname": "info",
                                "sl_column": "BestellnummerKunde",
                                "reqd": 1
                            }
                        ]
                    },
					{
						"fieldname": "items",
						"multiple_query": true,
						"multiple_query_table": "BelegZeile",
						"multiple_query_condition": "Kennung = 'A' AND Jahr = {Jahr} AND Nummer = {Nummer} AND Menge > 0 AND Artikelnummer > 0",
						"table_fields": [
							{
								"table_fieldname": "item_code",
								"sl_column": "Artikelnummer",
								"force_str_type": 1,
								"reqd": 1
							},
							{
								"table_fieldname": "item_name",
								"sl_column": "Bezeichnung"
							},
							{
								"table_fieldname": "qty",
								"sl_column": "Menge",
								"reqd": 1
							},
							{
								"table_fieldname": "uom",
								"sl_column": "Einheit",
								"force_str_type": 1,
								"reqd": 1
							},
							{
								"table_fieldname": "rate",
								"sl_column": "Preis/EH"
							},
							{
								"table_fieldname": "discount_percentage",
								"sl_column": "Rabatt"
							},
							{
								"table_fieldname": "warehouse",
								"default": "Stores - ACK"
							}
						]
					}
				]
			}
		]
	}
]
