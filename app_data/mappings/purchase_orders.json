[
 {
  "_comment": "=== Purchase Order import from OfficeNo1 (SelectLine) 4D database ===",
  "_comment2": "Mirrors the officeno1_sales_orders instance: only purchase orders that are NOT fully delivered are imported (allesgeliefert flag), line items come from BESTELLUNGpos",
  "_comment3": "Sales orders park the already delivered qty in custom_custom_text_1 / MENGEGELIEFERT; for purchase orders the delivered qty per line is mapped onto the item's received_qty (MengeGeliefert), so per_received is calculated by ERPNext from real numbers",
  "_comment4": "IMPORTANT: sl_column, primary_key, order_by, timestamp_column_name and the {PLACEHOLDER} of the child query must be UPPERCASE because the 4D driver returns uppercase dict keys",
  "idx": 1,
  "type": "PurchaseOrder",
  "doc_type": "Purchase Order",
  "table_name": "BESTELLUNG",
  "primary_key": "BESTELLNR",
  "order_by": "BESTELLNR DESC",
  "timestamp_column_name": "LETZTEAENDERUNG",
  "timestamp_column_type": "datetime",
  "query_filter": "t.[allesgeliefert] IS NULL OR t.[allesgeliefert] = false",
  "mapping": [
   {
    "doctype": "Purchase Order",
    "reqd": 1,
    "doctype_flags": [
     {
      "ignore_validate": 1
     },
     {
      "ignore_links": 1
     }
    ],
    "fields": [
     {
      "_comment": "--- Supplier (Lieferant, synced by officeno1_migration) ---",
      "fieldname": "supplier",
      "sl_column": "LIEFERANTENNR",
      "force_str_type": 1,
      "reqd": 1
     },
     {
      "fieldname": "transaction_date",
      "sl_column": "BESTELLDATUM",
      "reqd": 1
     },
     {
      "_comment": "--- Keep the ERPNext naming series of the existing (manually created) purchase orders ---",
      "fieldname": "naming_series",
      "default": "LNG-BE-2026-.####"
     },
     {
      "fieldname": "company",
      "default": "Lang Kunstgewerbe GmbH"
     },
     {
      "_comment": "--- Currency: 4D stores 'Eur' / 'EUR' / 'USD' ---",
      "fieldname": "currency",
      "sl_column": "WAEHRUNG",
      "value_map": {
       "Eur": "EUR",
       "EUR": "EUR",
       "USD": "USD"
      },
      "value_map_default": "EUR"
     },
     {
      "_comment": "--- Buying price list must match the currency ---",
      "fieldname": "buying_price_list",
      "sl_column": "WAEHRUNG",
      "value_map": {
       "USD": "Standard-Kauf-USD"
      },
      "value_map_default": "Standard-Kauf"
     },
     {
      "fieldname": "conversion_rate",
      "sl_column": "UMRECHFRW"
     },
     {
      "fieldname": "payment_terms_template",
      "sl_column": "ZAHLUNGSBED"
     },
     {
      "_comment": "--- Source order number (OfficeNo1 BestellNr) for traceability, like the manual POs ---",
      "fieldname": "custom_header_text",
      "sl_column": "BESTELLNR",
      "force_str_type": 1
     },
     {
      "fieldname": "custom_shipping_date",
      "sl_column": "LIEFERDATUM"
     },
     {
      "fieldname": "custom_confirmed_delivery_date",
      "sl_column": "BESTAETIGTES_LIEFERDATUMK"
     },
     {
      "fieldname": "custom_footer_text",
      "sl_column": "FUSSTEXT"
     },
     {
      "fieldname": "custom_additional_info_text",
      "sl_column": "BEMERKUNG"
     },
     {
      "_comment": "--- Order lines from BESTELLUNGpos (condition is matched against the parent row) ---",
      "fieldname": "items",
      "multiple_query": 1,
      "multiple_query_table": "BESTELLUNGpos",
      "multiple_query_condition": "BestellNr = {BESTELLNR}",
      "match_key_column": "PRIMARYKEY",
      "table_fields": [
       {
        "table_fieldname": "item_code",
        "sl_column": "ARTIKELNR",
        "reqd": 1
       },
       {
        "table_fieldname": "item_name",
        "sl_column": "POSBEZEICHNUNG",
        "reqd": 1,
        "trim": 140
       },
       {
        "table_fieldname": "qty",
        "sl_column": "MENGE",
        "reqd": 1
       },
       {
        "table_fieldname": "uom",
        "sl_column": "ME"
       },
       {
        "table_fieldname": "conversion_factor",
        "default": 1
       },
       {
        "table_fieldname": "rate",
        "sl_column": "PREIS_EK"
       },
       {
        "table_fieldname": "price_list_rate",
        "sl_column": "PREIS_EK"
       },
       {
        "table_fieldname": "discount_percentage",
        "sl_column": "RABATT"
       },
       {
        "_comment": "--- Already delivered qty per line (MengeGeliefert) -> ERPNext received qty / per_received ---",
        "table_fieldname": "received_qty",
        "sl_column": "MENGEGELIEFERT"
       },
       {
        "table_fieldname": "schedule_date",
        "sl_column": "LIEFERDATUM",
        "reqd": 1
       },
       {
        "table_fieldname": "warehouse",
        "default": "Lagerräume - LNG"
       }
      ]
     }
    ]
   }
  ]
 }
]
