[
    {
        "idx": 1,
        "type": "Item",
        "doc_type": "Item",
        "table_name": "ART A1",
        "timestamp_column_name": "GeaendertAm",
        "primary_key": "ART_ID",
        "mapping": [
            {
                "doctype": "Item Group",
                "fields": [
                    {"fieldname": "item_group_name", "sl_column": "(SELECT Bezeichnung FROM GRUPPEN A2 WHERE A2.GRUPPEN_ID = A1.Artikelgruppe) AS ItemGroupName", "alt_key": "ItemGroupName"}
                ]
            },
            {
                "doctype": "UOM",
                "fields": [
                    {"fieldname": "uom_name", "sl_column": "Mengeneinheit"}
                ]
            },
            {
                "doctype": "Item",
                "fields": [
                    {"fieldname": "item_code", "sl_column": "Artikelnummer"},
                    {"fieldname": "is_stock_item", "default": 1},
                    {"fieldname": "Item_name", "sl_column": "Bezeichnung"},
                    {"fieldname": "description", "sl_column": "CONCAT(Zusatz, CHAR(10), (SELECT TOP (1) t.[TEXT] FROM [TEXT] AS t WHERE t.BLOBKEY = CONCAT('AR', Artikelnummer))) AS concatedDesc", "alt_key": "concatedDesc"},
                    {"fieldname": "custom_matchcode", "sl_column": "Matchcode"},
                    {"fieldname": "item_group", "sl_column": "(SELECT Bezeichnung FROM GRUPPEN A2 WHERE A2.GRUPPEN_ID = A1.Artikelgruppe) AS ItemGroupName", "alt_key": "ItemGroupName"},
                    {"fieldname": "stock_uom", "sl_column": "Mengeneinheit"},
                    {"fieldname": "barcodes", "table_fields": [
                        {"table_fieldname": "barcode", "sl_column": "EANNummer"},
                        {"table_fieldname": "barcode_type", "default": "EAN"},
                        {"table_fieldname": "uom", "sl_column": "Mengeneinheit"}
                    ]}
                ]
            }
        ]
    },
    {
        "idx": 2,
        "type": "Customer",
        "doc_type": "Customer",
        "table_name": "Kunden",
        "timestamp_column_name": "BearbeitetAm",
        "primary_key": "KUNDEN_ID",
        "mapping": [
            {
                "doctype": "Customer",
                "reqd": 1,
                "fields": [
                    {"fieldname": "name", "sl_column": "Nummer", "reqd": 1},
                    {"fieldname": "customer_name", "sl_column": "(SELECT IF(TRIM(Name) <> '', Name, Firma) AS NameToUse)", "reqd": 1, "alt_key": "NameToUse"},
                    {"fieldname": "customer_type", "default": "Company"},
                    {"fieldname": "tax_category", "default": "VK-Inland"},
                    {"fieldname": "tax_id", "sl_column": "SteueridentNr"},
                    {"fieldname": "customer_details", "sl_column": "CONCAT(Zusatz, CHAR(10), Zusatz2, CHAR(10), Zusatz3) AS details", "alt_key": "details"},
                    {"fieldname": "website", "sl_column": "Homepage"},
                    {"fieldname": "industry", "sl_column": "TEXT87"},
                    {"fieldname": "territory", "sl_column": "COUNTRY1"},
                    {"fieldname": "custom_notes", "sl_column": "NOTES0"}
                ]
            },
            {
                "doctype": "Address",
                "fields": [
                    {"fieldname": "address_line1", "sl_column": "Strasse"},
                    {"fieldname": "pincode", "sl_column": "PLZ"},
                    {"fieldname": "city", "sl_column": "Ort"},
                    {"fieldname": "country", "default": "Austria"},
                    {"fieldname": "links", "table_fields": [
                        {"table_fieldname": "link_doctype", "default": "Customer"},
                        {"table_fieldname": "link_name", "sl_column": "Nummer", "force_str_type": 1, "reqd": 1}
                    ]}
                ]
            },
            {
                "doctype": "Salutation",
                "fields": [
                    {"fieldname": "salutation", "sl_column": "TOPERSON0"}
                ]
            },
            {
                "doctype": "Academic Title",
                "fields": [
                    {"fieldname": "academic_title", "sl_column": "TITLE0"}
                ]
            },
            {
                "doctype": "Contact Function",
                "fields": [
                    {"fieldname": "function_name", "sl_column": "POSITION0"}
                ]
            },
            {
                "doctype": "Contact",
                "fields": [
                    {"fieldname": "first_name", "sl_column": "FIRSTNAME0"},
                    {"fieldname": "last_name", "sl_column": "LASTNAME0"},
                    {"fieldname": "salutation", "sl_column": "TOPERSON0"},
                    {"fieldname": "custom_academic_title", "sl_column": "TITLE0"},
                    {"fieldname": "custom_function", "sl_column": "POSITION0"},
                    {"fieldname": "custom_letter_salutation", "sl_column": "SALUTATION0"},
                    {"fieldname": "custom_birthday", "sl_column": "CAST(BIRTHDAY0 AS DATE) as BIRTHDAY", "alt_key": "BIRTHDAY"},
                    {"fieldname": "is_primary_contact", "default": 1},
                    {"fieldname": "email_ids", "table_fields": [
                        {"table_fieldname": "email_id", "sl_column": "EMAIL0"},
                        {"table_fieldname": "is_primary", "default": 1}
                    ]},
                    {"fieldname": "phone_nos", "table_fields": [
                        {"table_fieldname": "phone", "sl_column": "PHONE0"},
                        {"table_fieldname": "is_primary_phone", "default": 1}
                    ]},
                    {"fieldname": "phone_nos", "table_fields": [
                        {"table_fieldname": "phone", "sl_column": "MOBILEPHONE0"},
                        {"table_fieldname": "is_primary_mobile_no", "default": 1}
                    ]},
                    {"fieldname": "links", "table_fields": [
                        {"table_fieldname": "link_doctype", "default": "Customer"},
                        {"table_fieldname": "link_name", "sl_column": "TEXT85", "force_str_type": 1, "reqd": 1}
                    ]}
                ]
            }
        ]
    }
]